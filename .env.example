# Every key below maps to a field on Settings in config.py. A key that does NOT
# match a field is silently ignored (extra="ignore") - the server logs a warning
# naming it at startup, so watch for that if a setting seems to do nothing.

# --- Server ---
# Bind address used by `python main.py`. Keep 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1
# Must match the port in GOOGLE_REDIRECT_URI / REDDIT_REDIRECT_URI.
PORT=8000

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
PAGESPEED_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./seo.db
REDIS_URL=
CORS_ORIGINS=http://localhost:5173
# Localhost and private-LAN origins (192.168.x.x / 10.x / 172.16-31.x, any port) are
# ALSO allowed by default via CORS_ORIGIN_REGEX - set it empty to allow only CORS_ORIGINS.
# CORS_ORIGIN_REGEX=
CACHE_TTL_SECONDS=3600

# --- MongoDB (Search Console reporting data; never OAuth tokens) ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=seo_remaster
# How long to wait before declaring MongoDB unreachable. Persistence is
# best-effort, so this is how long a request can stall on a dead database.
MONGODB_TIMEOUT_MS=1500

# --- Google Search Console OAuth ---
# From Google Cloud Console -> APIs & Services -> Credentials -> your OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an "Authorized redirect URI" configured on that OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Signs the session cookie. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Browser return address after connecting; also added to the allowed CORS origins
FRONTEND_URL=http://localhost:5173

# --- Gemini (Reddit post drafting) ---
# Key from Google AI Studio: https://aistudio.google.com/apikey
# Empty -> POST /api/backlinks/reddit/drafts answers 503; everything else keeps working.
GEMINI_API_KEY=
# Flash-class default. Check https://ai.google.dev/gemini-api/docs/models for the current list.
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when GEMINI_MODEL is overloaded while writing a report. Keep to
# models this key can call (a flash-tier key gets 429 on pro models).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# --- Ollama (local report engine: the "Create report" local button) ---
# Pull the model first: ollama pull <model>. A thinking model (qwen3) spends its
# whole budget reasoning on a CPU-only machine; prefer an instruct model there.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Seconds to wait for the whole report; a small model on CPU needs minutes.
OLLAMA_TIMEOUT_S=1800
# Context window floor in tokens; raised automatically when a prompt needs more.
OLLAMA_NUM_CTX=16384

# --- Claude via the Claude Code CLI (report engine) ---
# No API key: "Create report with Claude" runs the `claude` command already
# logged in on this machine (that account's usage limits apply). Install with
# `npm install -g @anthropic-ai/claude-code`, then run `claude` once to log in.
# A command name on PATH or a full path to the executable.
CLAUDE_CLI_PATH=claude
# Blank = the CLI's own default model / effort. Aliases work: sonnet, opus, fable.
CLAUDE_CLI_MODEL=
CLAUDE_CLI_EFFORT=
# Seconds to wait for the whole report before killing the CLI (a full audit on a
# large model at high effort can take several minutes).
CLAUDE_CLI_TIMEOUT_S=900

# --- Reddit Backlink (beta) ---
# Create a "web app" at https://www.reddit.com/prefs/apps
# Either client value empty -> /auth/reddit/* and the backlink endpoints answer 503.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Must EXACTLY match the redirect URI configured on that Reddit app
REDDIT_REDIRECT_URI=http://localhost:8000/auth/reddit/callback
# Reddit REQUIRES <platform>:<app id>:<version> (by /u/<username>) - put YOUR username here.
# A generic or missing User-Agent gets aggressively throttled.
REDDIT_USER_AGENT=web:seo-analyzer:v0.1.0 (by /u/CHANGE_ME)
REDDIT_SCOPES=identity submit read mysubreddits flair
# Volume guardrails - keep the connected account alive and inside Reddit's terms.
REDDIT_MAX_POSTS_PER_DAY=5
REDDIT_MIN_MINUTES_BETWEEN_POSTS=10
REDDIT_DEDUPE_DAYS=30

# --- Shopify store connection (Admin API) ---
# Create an app in the Shopify Dev Dashboard (dev.shopify.com) and copy its client
# ID and secret. In the app's version settings set:
#   App URL:       http://localhost:8000/auth/shopify/app
#   Redirect URLs: http://localhost:8000/auth/shopify/callback
#   Embed app in Shopify admin: off (this is a standalone app)
# Shopify requires the App URL and the redirect URL to share a HOST, or the
# authorize page fails with "redirect_uri and application url must have matching hosts".
# Either client value empty -> /auth/shopify/* and /api/shopify/* report "not configured".
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Must EXACTLY match a redirect URL configured on the app.
SHOPIFY_REDIRECT_URI=http://localhost:8000/auth/shopify/callback
# Comma-separated Admin API access scopes. read_products is what the product list needs.
SHOPIFY_SCOPES=read_products
SHOPIFY_API_VERSION=2026-10
# Encrypts stored access/refresh tokens. Any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Blank falls back to SESSION_SECRET. Changing it makes every store reconnect.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# --- Store catalog crawler ---
# Discovery (products.json / collections.json / sitemap) is never capped.
# Enrichment fetches one <head> per item (~0.2 s each); this bounds it so a huge
# catalog finishes as "partial" instead of holding a crawl slot for half an hour.
CRAWL_MAX_ENRICH_ITEMS=2000
CRAWL_ENRICH_CONCURRENCY=8
# Honest bot identity with a contact URL. Do not set a browser UA here.
CRAWLER_USER_AGENT=SEOAnalyzerBot/0.1 (+https://github.com/seo-remaster/bot)
# Opt-in (no measured gain on small catalogs). Needs `pip install "httpx[http2]"`;
# falls back to HTTP/1.1 automatically if h2 is missing.
CRAWL_HTTP2=false
