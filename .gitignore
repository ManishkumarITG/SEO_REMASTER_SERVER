# Python वर्चुअल एनवायरमेंट फोल्डर
venv/
env/
.venv/
ENV/
.env
# pip इंस्टॉल से आने वाली अन्य फाइल्स
bin/
lib/
share/
include/

# PyInstaller या बिल्ड फाइल्स (यदि लागू हो)
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Python bytecode caches - these were tracked, which buried real diffs in .pyc churn
__pycache__/
*.py[cod]

# Tooling caches
.pytest_cache/
.ruff_cache/

# Secret-bearing variants of .env (.env itself is ignored above).
# A staged .env.bak once put live Google/Gemini keys one commit away from history.
.env.bak
.env.local
.env.*.local
*.bak
